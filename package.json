{
  "name": "fitback",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev-phone.mjs",
    "dev:phone": "node scripts/dev-phone.mjs",
    "dev:vite": "vite --host",
    "always-on": "node scripts/always-on.mjs",
    "always-on:install": "node scripts/always-on-setup.mjs install",
    "always-on:uninstall": "node scripts/always-on-setup.mjs uninstall",
    "arbox:api": "node scripts/arbox-api.mjs",
    "build": "tsc && vite build",
    "ios:build": "tsc && vite build --mode ios && cap sync ios && npm run ios:setup",
    "ios:setup": "ruby scripts/ios-xcode-setup.rb",
    "ios:open": "cap open ios",
    "watch:build": "node scripts/watch-build.mjs",
    "watch:sim": "node scripts/watch-build.mjs --run",
    "logos": "node scripts/generate-logos.mjs",
    "sms:api": "node scripts/sms-api.mjs",
    "whatsapp:api": "node scripts/whatsapp-api.mjs",
    "email:api": "node scripts/email-api.mjs",
    "preview": "vite preview --host"
  },
  "dependencies": {
    "@capacitor/app": "^5.0.8",
    "@capacitor/core": "^5.7.8",
    "jose": "^6.2.9",
    "lucide-react": "^0.460.0",
    "nodemailer": "^10.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@capacitor/ios": "^5.7.8",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
