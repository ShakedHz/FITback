# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Authorized JavaScript origins: http://localhost:5199
# Authorized redirect URIs: http://localhost:5199/auth/google/callback
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple (Apple Developer → Identifiers → Services ID)
# Return URLs must include your app origin, e.g. http://localhost:5199
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:5199

# Optional: real Arbox partner API base URL (production backend)
# Dev uses Vite proxy /api/arbox → local read-only relay (npm run dev)
# VITE_ARBOX_API_URL=

# Demo Arbox data only when proxy is off (off by default)
# VITE_ARBOX_ALLOW_DEMO=true

# SMS is OFF by default — set only when you intentionally want to send messages
# VITE_ENABLE_SMS=true
# VITE_SMS_API_URL=http://localhost:5200
