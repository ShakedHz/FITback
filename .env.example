# Google Sign-In (Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID)
# Application type: Web application
# Authorized JavaScript origins: http://localhost:5199
#   Also add your LAN origin when testing on a phone, e.g. http://192.168.x.x:5199
# Authorized redirect URIs: http://localhost:5199/auth/google/callback
VITE_GOOGLE_CLIENT_ID=

# Sign in with Apple (Apple Developer → Identifiers → Services ID)
# Return URLs must match exactly (HTTPS in production; localhost is allowed for dev)
# e.g. http://localhost:5199
VITE_APPLE_CLIENT_ID=
VITE_APPLE_REDIRECT_URI=http://localhost:5199

# Optional: real Arbox partner API base URL (production backend)
# Dev uses Vite proxy /api/arbox → local read-only relay (npm run dev)
# VITE_ARBOX_API_URL=

# Demo Arbox data only when proxy is off (off by default)
# VITE_ARBOX_ALLOW_DEMO=true

# SMS is OFF by default — set only when you intentionally want to send messages
# VITE_ENABLE_SMS=true
# VITE_SMS_API_URL=http://localhost:5200

# FITback WhatsApp Cloud API — one number for every studio. Never expose these as VITE_*.
# Dev: Vite proxies /api/whatsapp → local relay (npm run dev)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Optional. Defaults: class_feedback / he / title_url ({{1}} class name, {{2}} survey URL)
# WHATSAPP_TEMPLATE_NAME=class_feedback
# WHATSAPP_TEMPLATE_LANG=he
# WHATSAPP_TEMPLATE_VARS=title_url
# Production backend (if the app is not using the local proxy):
# VITE_WHATSAPP_API_URL=
